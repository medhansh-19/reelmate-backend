# Create a NEW Supabase project and NEW R2 credentials for ReelMate.
# Never copy credentials from another application or commit the populated .env.
# Spotify credentials are deliberately not configured; see docs/EXTERNAL_CONNECTIONS.md.

APP_ENV=development
LOG_LEVEL=INFO
# Expo web normally runs on port 8081; add your deployed web origin here too.
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Supabase Postgres connection (use the project pooler URL for hosted workers).
DATABASE_URL=
SUPABASE_URL=
SUPABASE_JWT_AUDIENCE=authenticated
# Leave blank to infer ${SUPABASE_URL}/auth/v1; an override must match this project.
SUPABASE_JWT_ISSUER=

# Private Cloudflare R2 bucket dedicated to ReelMate.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=reelmate-videos
R2_KEY_PREFIX=reelmate/analyses
R2_UPLOAD_EXPIRY_SECONDS=900

WORKER_ID=reelmate-worker-1
WORKER_POLL_SECONDS=2
WORKER_LEASE_SECONDS=600
WORKER_JOB_TIMEOUT_SECONDS=600
WORKER_MAX_ATTEMPTS=3

MAX_VIDEO_BYTES=100000000
MAX_VIDEO_DURATION_SECONDS=90
MAX_IMAGE_BYTES=15000000
SOURCE_RETENTION_HOURS=24
