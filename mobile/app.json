{
  "expo": {
    "name": "ReelMate",
    "slug": "reelmate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "reelmate",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.reelmate.coach",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.reelmate.coach",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#11100F",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#11100F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 128,
          "dark": {
            "backgroundColor": "#11100F",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow ReelMate to access a reel you choose for private analysis.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-video",
        {
          "supportsPictureInPicture": false
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
