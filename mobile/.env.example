# Public mobile configuration only. Create a NEW Supabase project for ReelMate.
# Never place database passwords, Supabase service-role keys, R2 credentials,
# or credentials copied from another project in this file.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_NEW_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_FROM_NEW_PROJECT
EXPO_PUBLIC_API_URL=https://api.reelmate.example
EXPO_PUBLIC_DEMO_MODE=false
